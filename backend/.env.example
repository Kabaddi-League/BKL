# =========================================================
# BKL AUCTION PLATFORM - PRODUCTION ENVIRONMENT VARIABLES
# =========================================================

# 1. SUPABASE DATABASE (PostgreSQL)
# Get this from Supabase Dashboard -> Settings -> Database -> Connection string (JDBC)
# Example: jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DB_URL=jdbc:h2:mem:bkldb
DB_DRIVER=org.postgresql.Driver
DB_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Supabase database user (usually 'postgres')
DB_USERNAME=postgres
# Your database password
DB_PASSWORD=your_db_password

# 2. SUPABASE STORAGE (For Profile Pictures)
# Get this from Supabase Dashboard -> Settings -> API
# Example: https://YOUR_PROJECT_REF.supabase.co
SUPABASE_URL=

# Provide either anon key or service_role key
SUPABASE_KEY=

# Name of the storage bucket you created in Supabase (default is profile-images)
SUPABASE_BUCKET=profile-images

# 3. SECURITY (Change this in production!)
JWT_SECRET=YOUR_SUPER_SECRET_PRODUCTION_KEY_AT_LEAST_32_CHARS
